# Optional. A Discord BOT token; if set, Scope skips the login screen.
# The bot needs the Presence, Server Members and Message Content intents enabled in the Developer Portal.
DISCORD_BOT_TOKEN="your bot token"

# Optional. A token of any kind; DISCORD_TOKEN_KIND selects how it is used (bot|user, default bot).
# DISCORD_TOKEN="your token"
# DISCORD_TOKEN_KIND=bot

# Optional. Set to 1 to run the offline demo backend (sample servers, live fake traffic).
# SCOPE_DEMO=1
